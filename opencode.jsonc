{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "deny",
      ".paper-repro/**": "allow",
      "results/**": "allow",
      "configs/**": "allow",
      "scripts/**": "allow",
      "environment*.yml": "allow",
      "requirements*.txt": "allow",
      "README_REPRO.md": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd*": "allow",
      "ls*": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "tree*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git diff*": "allow",
      "git clone*": "allow",
      "git lfs*": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pip *": "allow",
      "conda *": "allow",
      "mamba *": "allow",
      "nvidia-smi*": "allow",
      "nvcc *": "allow",
      "df *": "allow",
      "du *": "allow",
      "free *": "allow",
      "uname *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "ask",
      "chmod *": "ask",
      "wget *": "allow",
      "curl *": "allow",
      "aria2c *": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "yum *": "deny",
      "dnf *": "deny",
      "git push*": "deny",
      "git commit*": "ask",
      "docker *": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "doom_loop": "ask",
    "external_directory": {
      "~/.cache/huggingface/**": "allow",
      "~/.cache/torch/**": "allow",
      "~/.local/state/opencode-paper-repro/**": "allow"
    }
  }
}
