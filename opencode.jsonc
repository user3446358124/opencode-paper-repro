{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.config/paper-repro/**": "deny",
      "~/.ssh/**": "deny",
      "~/.git-credentials": "deny",
      "~/.netrc": "deny",
      "~/.aws/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.config/huggingface/**": "deny",
      "~/.cache/huggingface/token": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.condarc": "deny",
      "/etc/shadow": "deny",
      "/etc/gshadow": "deny",
      "/etc/sudoers": "deny"
    },
    "edit": {
      "*": "deny",
      ".paper-repro/**": "allow",
      "results/**": "allow",
      "configs/**": "allow",
      "scripts/**": "allow",
      "environment*.yml": "allow",
      "requirements*.txt": "allow",
      "README_REPRO.md": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd*": "allow",
      "ls*": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "tree*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git diff*": "allow",
      "git clone*": "allow",
      "git lfs*": "allow",
      "python *": "deny",
      "python3 *": "deny",
      "pip *": "deny",
      "pip3 *": "deny",
      "torchrun *": "deny",
      "accelerate *": "deny",
      "deepspeed *": "deny",
      "setsid *": "deny",
      "nohup *": "deny",
      "conda *": "allow",
      "mamba *": "allow",
      "nvidia-smi*": "allow",
      "nvcc *": "allow",
      "df *": "allow",
      "du *": "allow",
      "free *": "allow",
      "uname *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "ask",
      "chmod *": "ask",
      "wget *": "allow",
      "curl *": "allow",
      "aria2c *": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "yum *": "deny",
      "dnf *": "deny",
      "git push*": "deny",
      "git commit*": "ask",
      "docker *": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "doom_loop": "ask",
    "external_directory": {
      "~/.cache/huggingface/**": "allow",
      "~/.cache/torch/**": "allow",
      "~/.local/state/opencode-paper-repro/**": "allow"
    }
  }
}
