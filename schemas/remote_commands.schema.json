{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-repro.local/schemas/remote-contract/v1/commands.json",
  "title": "Paper Reproduction Remote Command List v1",
  "type": "object",
  "required": ["schema_version", "workspace_id", "run_id", "commands"],
  "properties": {
    "schema_version": {"const": 1},
    "workspace_id": {"type": "string", "pattern": "^ws-[0-9a-f]{12}$"},
    "run_id": {"type": "string"},
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "request_id", "workspace_id", "run_id", "target", "type", "state", "created_at", "updated_at"],
        "properties": {
          "schema_version": {"const": 1},
          "request_id": {"type": "string", "minLength": 1},
          "workspace_id": {"type": "string", "pattern": "^ws-[0-9a-f]{12}$"},
          "run_id": {"type": "string"},
          "target": {"enum": ["opencode", "paper-repro"]},
          "type": {"enum": ["prompt", "slash-command", "permission", "question", "decision", "diagnostic"]},
          "state": {"enum": ["queued", "dispatched", "accepted", "completed", "failed", "expired", "cancelled"]},
          "session_id": {"type": ["string", "null"]},
          "requires_idle": {"type": "boolean"},
          "priority": {"enum": ["low", "normal", "high"]},
          "ttl_seconds": {"type": "integer", "minimum": 0},
          "idempotency_key": {"type": ["string", "null"]},
          "summary": {"type": "string"},
          "payload_sha256": {"type": ["string", "null"]},
          "created_at": {"type": "string"},
          "updated_at": {"type": "string"},
          "source": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
