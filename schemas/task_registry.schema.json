{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper Reproduction Task Registry",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "display_name",
          "stage",
          "state",
          "gpu_request",
          "gpu_ids",
          "progress"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "gpu_request": {
            "type": "object"
          },
          "gpu_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "progress": {
            "type": "object"
          },
          "parallel_group_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "log_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sandbox": {
            "type": "object",
            "properties": {
              "allowed_roots": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "secret_env": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
