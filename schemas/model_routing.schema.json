{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper Reproduction Model Routing",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "policy": {
      "const": "native-first"
    },
    "native": {
      "type": "object",
      "properties": {
        "capability": {
          "enum": [
            "auto",
            "vision",
            "text-only"
          ]
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "protocol",
          "base_url",
          "model",
          "api_key_env",
          "capabilities"
        ],
        "properties": {
          "protocol": {
            "const": "openai-compatible"
          },
          "base_url": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "api_key_env": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
