{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-repro.local/schemas/remote-contract/v1/events.json",
  "title": "Paper Reproduction Remote Events v1",
  "type": "object",
  "required": ["schema_version", "workspace_id", "run_id", "cursor_scope", "events", "next_cursor", "has_more", "cursor_found"],
  "properties": {
    "schema_version": {"const": 1},
    "workspace_id": {"type": "string", "pattern": "^ws-[0-9a-f]{12}$"},
    "run_id": {"type": "string"},
    "cursor_scope": {"const": "run"},
    "after": {"type": ["string", "null"]},
    "cursor_found": {"type": "boolean"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "event_id", "type", "ts", "run_id", "task_id", "data"],
        "properties": {
          "schema_version": {"type": "integer", "minimum": 1},
          "event_id": {"type": "string", "pattern": "^EVT-[0-9]{12}$"},
          "type": {"type": "string", "minLength": 1},
          "ts": {"type": "string"},
          "run_id": {"type": "string"},
          "task_id": {"type": ["string", "null"]},
          "data": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "next_cursor": {"type": ["string", "null"], "pattern": "^EVT-[0-9]{12}$"},
    "has_more": {"type": "boolean"}
  },
  "additionalProperties": true
}
