{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper Reproduction Execution Plan",
  "type": "object",
  "required": [
    "schema_version",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "display_name",
          "command",
          "gpu_count"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "gpu_count": {
            "type": "integer",
            "minimum": 0
          },
          "gpu_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "min_free_memory_mb": {
            "type": "integer",
            "minimum": 0
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "estimate_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "priority": {
            "type": "integer"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "parallel_group_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "progress_adapter": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "auto",
                  "native",
                  "tqdm",
                  "jsonl-line-count",
                  "line-count",
                  "file-count",
                  "regex-log"
                ]
              },
              "path": {
                "type": "string"
              },
              "total": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              },
              "glob": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "output_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object"
          },
          "secret_env": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
            },
            "uniqueItems": true
          },
          "sandbox": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "auto",
                  "required",
                  "trusted-off"
                ]
              },
              "backend": {
                "enum": [
                  "auto",
                  "bubblewrap"
                ]
              },
              "network": {
                "enum": [
                  "on",
                  "off"
                ]
              },
              "allowed_roots": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "required",
            "trusted-off"
          ]
        },
        "backend": {
          "enum": [
            "auto",
            "bubblewrap"
          ]
        },
        "network": {
          "enum": [
            "on",
            "off"
          ]
        },
        "allowed_roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
